<!DOCTYPE html>
<html lang="{% if lang == 'ua' %}uk{% else %}{{ lang }}{% endif %}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set metadata = pageMetadata | metadataFor(page.url) %}
    <title>{{ metadata.title | default(title) }} — Doctrine Site</title>
    <meta name="description" content="{{ metadata.description | default(title) | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Doctrine Site">
    <meta property="og:title" content="{{ metadata.og_title | default(title) | escape }}">
    <meta property="og:description" content="{{ metadata.og_description | default(title) | escape }}">
    <meta property="og:url" content="https://gotocalmaidp.github.io{{ baseurl }}{{ page.url }}">
    <meta property="og:image" content="https://gotocalmaidp.github.io{{ baseurl }}/assets/applicability-boundary-social.png">
    <meta property="og:image:alt" content="{% if lang == 'en' %}Applicability Boundary Doctrine concept diagram{% else %}Концептуальна діаграма Доктрини межі застосовності{% endif %}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ metadata.twitter_title | default(title) | escape }}">
    <meta name="twitter:description" content="{{ metadata.twitter_description | default(title) | escape }}">
    <meta name="twitter:image" content="https://gotocalmaidp.github.io{{ baseurl }}/assets/applicability-boundary-social.png">
    <meta name="twitter:image:alt" content="{% if lang == 'en' %}Applicability Boundary Doctrine concept diagram{% else %}Концептуальна діаграма Доктрини межі застосовності{% endif %}">
    <link rel="stylesheet" href="{{ baseurl }}/css/style.css">
    {% if page.url == '/en/screening/' or page.url == '/ua/screening/' %}
    <link rel="stylesheet" href="{{ baseurl }}/assets/screening/screening-v12.css">
    {% endif %}
    <link rel="canonical" href="https://gotocalmaidp.github.io{{ baseurl }}{{ page.url }}">
    {% if lang == 'en' %}
    <link rel="alternate" hreflang="en" href="https://gotocalmaidp.github.io{{ baseurl }}{{ page.url }}">
    <link rel="alternate" hreflang="uk" href="https://gotocalmaidp.github.io{{ baseurl }}{{ page.url | langUrl(lang) }}">
    {% elif lang == 'ua' %}
    <link rel="alternate" hreflang="uk" href="https://gotocalmaidp.github.io{{ baseurl }}{{ page.url }}">
    <link rel="alternate" hreflang="en" href="https://gotocalmaidp.github.io{{ baseurl }}{{ page.url | langUrl(lang) }}">
    {% endif %}
    {% if page.url == '/en/citation/' or page.url == '/ua/citation/' %}
    <meta name="citation_title" content="Applicability Boundary Doctrine">
    <meta name="citation_author" content="Partasyuk, Vadym">
    <meta name="citation_publication_date" content="2025">
    <meta name="citation_technical_report_institution" content="GotoCalm AI-DP Doctrine Repository">
    <meta name="citation_url" content="https://gotocalmaidp.github.io/doctrine-site-box/">
    <meta name="citation_language" content="{% if lang == 'en' %}en{% else %}uk{% endif %}">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      "name": "Applicability Boundary Doctrine",
      "author": {
        "@type": "Person",
        "familyName": "Partasyuk",
        "givenName": "Vadym"
      },
      "datePublished": "2025",
      "version": "1.4.3",
      "publisher": {
        "@type": "Organization",
        "name": "GotoCalm AI-DP Doctrine Repository"
      },
      "url": "https://gotocalmaidp.github.io/doctrine-site-box/",
      "inLanguage": "{% if lang == 'en' %}en{% else %}uk{% endif %}"
    }
    </script>
    {% endif %}
</head>
<body>
    <header class="site-header">
        <div class="header-container">
            <div class="site-brand">
                <a href="{{ baseurl }}/{{ lang }}/">Doctrine</a>
            </div>
            
            <nav class="language-switcher">
                {% if lang == "en" %}
                <span class="lang-active">EN</span>
                <span class="lang-separator">|</span>
                <a href="{{ baseurl }}{{ page.url | langUrl(lang) }}" class="lang-link">UA</a>
                {% else %}
                <a href="{{ baseurl }}{{ page.url | langUrl(lang) }}" class="lang-link">EN</a>
                <span class="lang-separator">|</span>
                <span class="lang-active">UA</span>
                {% endif %}
            </nav>
        </div>
        
        <nav class="primary-nav">
            <ul>
                {% for item in navigation[lang] %}
                <li{% if page.url == item.url %} class="active"{% endif %}>
                    <a href="{{ item.url }}">{{ item.title }}</a>
                </li>
                {% endfor %}
            </ul>
        </nav>
    </header>

    <main class="site-main">
        <article class="content">
            {{ content | safe }}
        </article>
    </main>

    <footer class="site-footer">
        <div class="footer-container">
            <p>
                {% if lang == "en" %}
                Doctrine Site — Versioned Conceptual Framework
                {% else %}
                Doctrine Site — Версіонована концептуальна рамка
                {% endif %}
            </p>
            <nav class="footer-nav">
                <a href="{{ baseurl }}/{{ lang }}/">
                    {% if lang == "en" %}Home{% else %}Головна{% endif %}
                </a>
                <a href="{{ baseurl }}/{{ lang }}/contact/">
                    {% if lang == "en" %}Contact{% else %}Контакти{% endif %}
                </a>
            </nav>
            <nav class="footer-governance">
                <a href="{{ baseurl }}/{{ lang }}/scope/">
                    {% if lang == "en" %}Scope{% else %}Межі застосування{% endif %}
                </a>
                <span class="legal-separator">|</span>
                <a href="{{ baseurl }}/{{ lang }}/evidence/">
                    {% if lang == "en" %}Evidence{% else %}Доказовість{% endif %}
                </a>
                <span class="legal-separator">|</span>
                <a href="{{ baseurl }}/{{ lang }}/change-log/">
                    {% if lang == "en" %}Change Log{% else %}Журнал змін{% endif %}
                </a>
            </nav>
            <nav class="footer-legal">
                <a href="{{ baseurl }}/{{ lang }}/terms/">
                    {% if lang == "en" %}Terms{% else %}Умови{% endif %}
                </a>
                <span class="legal-separator">|</span>
                <a href="{{ baseurl }}/{{ lang }}/privacy/">
                    {% if lang == "en" %}Privacy{% else %}Конфіденційність{% endif %}
                </a>
                <span class="legal-separator">|</span>
                <a href="{{ baseurl }}/{{ lang }}/cookies/">Cookies</a>
                <span class="legal-separator">|</span>
                <a href="{{ baseurl }}/{{ lang }}/disclaimer/">
                    {% if lang == "en" %}Disclaimer{% else %}Дисклеймер{% endif %}
                </a>
            </nav>
            <p class="footer-contact">Contact: <a href="mailto:admin@gotocalm.com">admin@gotocalm.com</a></p>
            <p class="footer-scope">
                {% if lang == "en" %}
                This site presents a conceptual doctrine for analysing complex automated, AI-enabled and safety-critical systems, including systems operating in regulated or high-consequence environments. It does not prescribe operational procedures and does not replace regulatory safety investigations.
                {% else %}
                Цей сайт представляє концептуальну доктрину для аналізу складних автоматизованих, з підтримкою ШІ та критично важливих для безпеки систем, включаючи системи що працюють у регульованих середовищах або середовищах з високими наслідками. Він не визначає операційних процедур та не замінює регуляторних розслідувань безпеки.
                {% endif %}
            </p>
            <p class="footer-ip">
                {% if lang == "en" %}
                This site describes conceptual doctrine and terminology. Implementation architectures, detection mechanisms, and operational protocols remain proprietary.
                {% else %}
                Цей сайт описує концептуальну доктрину та термінологію. Архітектури реалізації, механізми виявлення та операційні протоколи залишаються власністю.
                {% endif %}
            </p>
            <p class="footer-commentary">
                {% if lang == "en" %}
                Public commentary and short observations related to the doctrine may appear on:
                <a href="https://x.com/VadymPartasyuk" target="_blank" rel="noopener noreferrer">X — @VadymPartasyuk</a>
                {% else %}
                Публічні коментарі та короткі спостереження щодо доктрини можуть з'являтися на:
                <a href="https://x.com/VadymPartasyuk" target="_blank" rel="noopener noreferrer">X — @VadymPartasyuk</a>
                {% endif %}
            </p>
        </div>
    </footer>
    {% if page.url == '/en/screening/' or page.url == '/ua/screening/' %}
    <script type="module" src="{{ baseurl }}/assets/screening/screening-v12.js?release=2026-09-22-bridge"></script>
    {% endif %}
</body>
</html>
